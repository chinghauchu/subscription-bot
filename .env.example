# Copy to .env.local. Missing keys must never crash the app.
# AdMob / IAP are optional until App Store Connect + AdMob are configured.

# One-time non-consumable product id (App Store Connect)
# Suggested id: subassist_remove_ads
EXPO_PUBLIC_IAP_REMOVE_ADS_ID=subassist_remove_ads

# Public legal pages. Leave unset to use these defaults.
EXPO_PUBLIC_PRIVACY_URL=https://chinghauchu.github.io/subscription-bot/privacy.html
EXPO_PUBLIC_TERMS_URL=https://chinghauchu.github.io/subscription-bot/terms.html

# AdMob application IDs (do not add the native ads plugin until these are real)
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=

# Banner unit IDs used only when the native ads SDK is present
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=

# Optional EAS project id after `eas init`
EAS_PROJECT_ID=
